    "Approval Is Pending": {"main": [[{"node": "Wait for Approval", "type": "main", "index": 0}], []]},
    "Wait for Approval": {"main": [[{"node": "Prepare Approval Status", "type": "main", "index": 0}]]},
    "Prepare Approval Status": {"main": [[{"node": "Hash Approval Status Body", "type": "main", "index": 0}]]},
