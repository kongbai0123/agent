    {
      "parameters": {"mode": "manual", "assignments": {"assignments": [
        {"id": "context-message-id", "name": "gmail_message_id", "type": "string", "value": "={{String($('Gmail Search').item.json.id||'').slice(0,128)}}"},
        {"id": "context-thread-id", "name": "gmail_thread_id", "type": "string", "value": "={{String($('Gmail Search').item.json.threadId||'').slice(0,128)}}"},
        {"id": "context-sender", "name": "sender", "type": "string", "value": "={{String($('Gmail Search').item.json.from?.value?.[0]?.address||'').slice(0,320)}}"},
        {"id": "context-subject", "name": "subject", "type": "string", "value": "={{String($('Gmail Search').item.json.subject||'').slice(0,998)}}"},
        {"id": "context-current-body", "name": "body_text", "type": "string", "value": "={{String($('Gmail Search').item.json.text||'').slice(0,100000)}}"},
        {"id": "context-label-id", "name": "workbench_label_id", "type": "string", "value": "={{(()=>{const current=($json.messages||[]).find(message=>message.id===$('Gmail Search').item.json.id)||{};return String((current.labels||[]).find(label=>label.name==='Workbench-Agent')?.id||'');})()}}"},
        {"id": "context-attachments", "name": "attachments", "type": "array", "value": "={{(()=>{const current=($json.messages||[]).find(message=>message.id===$('Gmail Search').item.json.id)||{};const metadata=[];const walk=part=>{if(!part||metadata.length>=50)return;if(part.body?.attachmentId){const size=Number(part.body.size||0);metadata.push({attachment_id:String(part.body.attachmentId).slice(0,128),filename:String(part.filename||'').slice(0,512),mime_type:String(part.mimeType||'application/octet-stream').slice(0,255),size_bytes:Number.isFinite(size)?Math.max(0,Math.floor(size)):0});}(part.parts||[]).forEach(walk);};walk(current.payload||{});return metadata;})()}}"},
        {"id": "context-thread-messages", "name": "thread_messages", "type": "array", "value": "={{(()=>{const currentId=String($('Gmail Search').item.json.id||'');const currentBody=String($('Gmail Search').item.json.text||'').slice(0,100000);let remaining=100000-currentBody.length;const decode=data=>String(data||'').replace(/-/g,'+').replace(/_/g,'/').base64Decode();const bodyOf=message=>{const plain=[];const html=[];const walk=part=>{if(!part)return;if(part.body?.data&&part.mimeType==='text/plain')plain.push(decode(part.body.data));if(part.body?.data&&part.mimeType==='text/html')html.push(decode(part.body.data).removeTags());(part.parts||[]).forEach(walk);};walk(message.payload||{});return (plain.length?plain:html).join('\\n');};const selected=($json.messages||[]).filter(message=>String(message.id||'')!==currentId).slice(-20).reverse();const newestFirst=selected.map(message=>{const text=bodyOf(message).slice(0,Math.max(0,remaining));remaining-=text.length;return {gmail_message_id:String(message.id||'').slice(0,128),sender:String(message.From||'').slice(0,320),subject:String(message.Subject||'').slice(0,998),body_text:text,sent_at:String(message.internalDate||message.Date||'').slice(0,64)};});return newestFirst.reverse();})()}}"}
      ]}, "includeOtherFields": false, "options": {}},
