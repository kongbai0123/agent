      "cronjob",
      "homeassistant",
      "spotify",
      "discord",
      "discord_admin",
      "yuanbao",
      "computer_use"
    ]
  },
  "readonly_tool_policy": {
    "profile": "project-readonly-v1",
    "toolset": "workbench-readonly",
    "tools": ["project_read_file", "project_search_files"],
    "config_template": {
      "path": "config/hermes-sidecar-docker-readonly-config.yaml",
      "sha256": "583845922fd3781ff3bf4f2fc86973bd5b49174506f7bb86bacd16d4e31074ba"
    },
    "python_policy": {
