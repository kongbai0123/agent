      "sha256": "f2e3625c3be19882f7847427ec0050c0fdb05d14204534576ae1d5a9f5662583",
      "container_directory": "/opt/workbench-policy"
    },
    "project_mount": "/workspace/project",
    "environment": {
      "PYTHONPATH": "/opt/workbench-policy",
      "WORKBENCH_POLICY_PROFILE": "project-readonly-v1",
      "WORKBENCH_PROJECT_ROOT": "/workspace/project"
    },
    "labels": {
      "com.local-ai-workbench.component": "hermes-sidecar",
      "com.local-ai-workbench.policy": "project-readonly-v1",
      "com.local-ai-workbench.owner": "workbench"
    },
    "tmpfs": {
      "/tmp": "rw,nosuid,size=512m",
      "/var/tmp": "rw,noexec,nosuid,size=256m",
      "/run": "rw,exec,nosuid,size=64m"
    },
    "writes_enabled": false,
    "shell_enabled": false,
    "network_tools_enabled": false
  },
  "security": {
    "minimum_api_key_bytes": 32,
    "loopback_publish_only": true,
    "cors_disabled": true,
    "app_approval_is_os_boundary": false,
    "requires_os_isolation_before_tools": true,
    "docker_pull_requires_data_drive_storage": true,
    "legacy_windows_home_forbidden": "%LOCALAPPDATA%/hermes"
