    "container_port": 8642,
    "health_path": "/health",
    "capabilities_path": "/v1/capabilities",
    "toolsets_path": "/v1/toolsets"
  },
  "production_policy": {
    "readiness": {
      "startup_timeout_seconds": 60,
      "probe_interval_milliseconds": 500,
      "required_consecutive_successes": 2,
      "health": {
        "status": "ok",
        "platform": "hermes-agent",
        "version": "0.18.2"
      },
      "required_features": [
        "run_approval_response",
        "run_events_sse",
        "run_status",
        "run_stop",
        "run_submission"
      ],
      "required_endpoints": {
        "runs": "/v1/runs",
        "run_status": "/v1/runs/{run_id}",
        "run_events": "/v1/runs/{run_id}/events",
        "run_approval": "/v1/runs/{run_id}/approval",
        "run_stop": "/v1/runs/{run_id}/stop"
      }
    },
    "monitoring": {
      "probe_interval_seconds": 10,
      "failure_threshold": 3,
      "max_restarts_per_launch": 2,
      "restart_backoff_seconds": 2
    },
    "rollback": {
      "safe_tool_policy_profile": "NoTools",
      "stop_owned_container_only": true,
      "preserve_runtime_data": true
    },
    "evidence": {
      "schema_version": 1,
      "relative_directory": "runtime/hermes/evidence",
      "forbidden_fields": [
        "api_key",
        "authorization",
        "canary_session_ids",
        "environment",
        "project_id",
        "project_root"
      ]
    }
  },
  "model": {
    "default": "gemma4-hermes:latest",
    "provider": "custom",
    "context_length": 64000,
    "max_output_tokens": 4096,
    "base_urls": {
      "native": "http://127.0.0.1:11434/v1",
      "docker": "http://host.docker.internal:11434/v1"
    }
  },
  "initial_policy": {
    "platform_toolsets": {"api_server": []},
    "mcp_servers": {},
    "plugins": {"enabled": [], "disabled": []},
    "safe_mode_environment": true,
    "cors_origins": [],
    "disabled_toolsets": [
      "web",
      "browser",
      "terminal",
      "file",
      "code_execution",
      "vision",
      "video",
      "image_gen",
      "video_gen",
      "x_search",
      "tts",
      "skills",
      "todo",
      "memory",
      "context_engine",
